# desc: Jetson Thor (sm_110a): the default hybrid recipe with the tcgen05 kernel paths armed (inert on GB10)
MODE=hybrid
YARN=1
CTX=500000
# Arm the Thor-only tcgen05 paths from Dockerfile patch 21 (trtllm-gen NVFP4 fused
# MoE, FlashInfer-first attention, FlashInfer GDN prefill, bf16x3 router GEMM).
# The patched gates also check the compute capability, so this is a no-op on a
# GB10/Spark box. serve.sh's TCGEN05=auto already does this on detected Thor
# hardware; the explicit value makes the profile self-documenting.
TCGEN05=1
