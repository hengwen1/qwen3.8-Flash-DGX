# desc: Jetson Thor (sm_110a): the default hybrid recipe with the verified tcgen05 path armed (inert on GB10)
MODE=hybrid
YARN=1
CTX=500000
# Arm the Thor-only tcgen05 gates from Dockerfile patch 21. Default-on: the
# bf16x3 cuTe-DSL router GEMM (verified on sm_110a). The other parts
# (VLLM_THOR_TCGEN05_MOE/ATTN/GDN) wait on flashinfer gaining sm_110 kernels —
# arming them on flashinfer 0.7.0 crashes the boot. The gates also check the
# compute capability, so this is a no-op on a GB10/Spark box. serve.sh's
# TCGEN05=auto already does this on detected Thor hardware; the explicit value
# makes the profile self-documenting.
TCGEN05=1
