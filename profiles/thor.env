# desc: Jetson Thor (sm_110a): the default hybrid recipe with the verified tcgen05 path armed (inert on GB10)
MODE=hybrid
YARN=1
CTX=500000
# Arm the Thor-only tcgen05 gates from Dockerfile patch 21. Default-on since
# 2026-10-20 (built into scripts/serve.sh on detected Thor boxes, no need to
# set anything here): the bf16x3 cuTe-DSL router GEMM and the validated
# FLASHINFER_CUTLASS NvFp4 fused MoE (+18% cold prefill, +4% decode, sound
# numerics — README), with flashinfer's JIT cache persisted at
# ~/.cache/qwen38-flash-dgx-compile (serve.sh builds it in a side container on
# first use, ~25 min, one-time). Opt back out with either line below:
#   VLLM_THOR_TCGEN05_MOE=0    stock VLLM_CUTLASS MoE, no JIT cache needed
#   COMPILE_CACHE=             caches stay inside the container as before
# ATTN/GDN wait on flashinfer gaining sm_110 kernels, and MOE_TRTLLM is dead
# until Sm110a cubins ship — arming those on flashinfer 0.7.0 crashes the boot.
# The gates also check the compute capability, so all of this is a no-op on a
# GB10/Spark box.
TCGEN05=1
